# 高德开放平台 Web端(JS API) Key,申请地址 https://lbs.amap.com/
# 创建应用时「服务平台」必须选择「Web端(JS API)」
VITE_AMAP_KEY=your_amap_js_api_key

# 安全密钥(jscode):2021 年 12 月后申请的 Key 必须配置,否则地图报 INVALID_USER_SCODE
# 在高德控制台的 Key 详情页可以看到;未配置时地图模块会降级为提示,其他功能不受影响
VITE_AMAP_SECURITY_CODE=your_amap_security_jscode

# ICP 备案号,例如 粤ICP备12345678号-1
# 备案通过后在首页底部展示并链接到工信部备案管理系统。
# **故意放在 .env 而不是写进源码** —— 备案信息属于站点运营者的备案主体信息,
# 没必要随公开仓库一起传播。未配置时页面底部不渲染备案号(也不会留下多余的间隔符)。
VITE_ICP_LICENSE=

# 公安联网备案号,例如 粤公网安备12345678901234号
# 同样在首页底部展示;组件会从号码里取出数字段,拼成公安部备案查询链接的 code 参数,
# 所以换备案号时只改这里就行,不用动代码。
VITE_PSB_LICENSE=
