# ===== 骑行看板后端 环境变量 =====
# 复制本文件为 .env 后修改。.env 已被 .gitignore 覆盖，绝不会进入 git。

# 运行模式。**务必保持 production**：
#   · 出错时不会把内部错误信息与堆栈返回给客户端（dev 模式会返回）
#   · 日志级别为 info（dev 模式是 warn，会多记一堆无关日志）
# 这一项必须写在这里，不能只写在 systemd 的 Environment= 里 —— 否则将来
# 改用宝塔「Node 项目」(PM2) 托管时就会丢失，导致内部信息外泄。
NODE_ENV=production

# 监听端口(宝塔反代指向这个端口即可)
PORT=3000

# 只监听本机:由 Nginx 反代对外，避免绕过 Nginx 直接暴露 Node
# 如果不用 Nginx、想直接用 IP:端口 访问，改成 0.0.0.0
HOST=127.0.0.1

# SQLite 数据库文件路径(相对本目录)。宝塔部署建议放到独立目录，方便单独备份
DATABASE_PATH=./data/cycling.db

# 会话签名密钥:必须改！改法: npm run gen-secret  然后粘贴到这里
# 一旦泄露，任何人都能伪造登录态；更换后所有用户需要重新登录
JWT_SECRET=请用-npm-run-gen-secret-生成一个随机值替换这里

# 会话有效期(天)
SESSION_DAYS=30

# Cookie 是否要求 HTTPS。线上用 HTTPS 时必须保持 true；
# 若暂时用 http://IP:端口 访问，先改成 false，否则浏览器不会保存登录态
COOKIE_SECURE=true

# 允许注册新账号。部署稳定后可改成 false，锁死注册入口
ALLOW_REGISTER=true

# 反向代理层数(宝塔 Nginx 反代时为 1)，用于取真实客户端 IP 做限流
TRUST_PROXY=1

# 登录/注册接口的限流:同一 IP 在 10 分钟内的最大尝试次数(防密码爆破)
AUTH_RATE_LIMIT_MAX=10

# ===== 站长控制台 =====

# 管理员白名单。填账号标识(逗号分隔)，或用 ADMIN_USER_IDS=1,2 按账号 id 指定。
# **故意放在这里而不是数据库**：数据库即使被改也提不了权；改完需要重启才生效。
# 没配任何管理员时，后端的 /api/admin/* 对所有人返回 403，「站长」分页也不会出现。
ADMIN_ACCOUNTS=

# 数据库备份目录(后台「备份管理」读写的就是这里)。
# 留空则用项目上一级的 backup/ 目录；生产环境建议指到一个独立目录，
# 方便跟着面板/云厂商的快照一起异地备份。
# 注意:后端进程要以运行用户对该目录**有读写权限**，否则备份列表会显示 0 份
BACKUP_DIR=

# 备份保留天数(与 scripts/backup.mjs 的 BACKUP_KEEP_DAYS 共用一个值)
BACKUP_KEEP_DAYS=30

# 后端日志文件路径，供后台「日志」页读取。留空则后台不提供日志查看
LOG_FILE=
